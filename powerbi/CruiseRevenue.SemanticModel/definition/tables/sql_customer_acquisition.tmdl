table sql_customer_acquisition
	lineageTag: fcbcf552-e498-4c61-928d-14fa07561220

	measure 'New Guests' = SUM(sql_customer_acquisition[new_guests])
		formatString: #,0
		lineageTag: b86bb11b-2b97-4286-ab6e-71176512b915

	measure 'Acquisition Revenue' = SUM(sql_customer_acquisition[confirmed_revenue])
		formatString: \$#,0
		lineageTag: 16a01458-15a5-4578-9aaa-92e03ff9d208

	column booking_year
