	partition sql_customer_acquisition = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\sql_customer_acquisition.csv"),[Delimiter=",", Columns=9, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"booking_year", Int64.Type}, {"channel", type text}, {"source_market", type text}, {"bookings", Int64.Type}, {"new_guests", type number}, {"repeat_bookings", type number}, {"confirmed_revenue", type number}, {"avg_price", type number}, {"cancel_rate_pct", type number}}, "en-US"),
				    #"Added Year" = Table.AddColumn(#"Changed Type", "booking_year_label", each Text.From([booking_year]), type text)
				in
				    #"Added Year"

	annotation PBI_ResultType = Table

