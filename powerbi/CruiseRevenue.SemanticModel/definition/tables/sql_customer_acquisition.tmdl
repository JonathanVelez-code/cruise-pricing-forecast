table sql_customer_acquisition
	lineageTag: e7700469-4c1b-4c57-9871-c269cfce88b2

	measure 'New Guests' = SUM(sql_customer_acquisition[new_guests])
		formatString: #,0
		lineageTag: 5a95957c-46bb-4652-ae96-5287ab87dc6e

	measure 'Acquisition Revenue' = SUM(sql_customer_acquisition[confirmed_revenue])
		formatString: \$#,0
		lineageTag: 72088ca7-fa09-4ba9-afde-fdd4e054bdfc

