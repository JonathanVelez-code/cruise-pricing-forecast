table feature_importance
	lineageTag: 8726528f-5e16-4ed7-bbab-d89e43c815a4

	column feature
		dataType: string
		lineageTag: c8f9cd28-8a7a-4a54-bac5-087b10d8aa12
		summarizeBy: none
		sourceColumn: feature

		annotation SummarizationSetBy = Automatic

	column importance
		dataType: double
		lineageTag: ac908e96-e4d8-4823-abda-fbfdbe9b94c1
		summarizeBy: sum
		sourceColumn: importance

		annotation SummarizationSetBy = Automatic

	partition feature_importance = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\feature_importance.csv"),[Delimiter=",", Columns=2, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"feature", type text}, {"importance", type number}}, "en-US")
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table

