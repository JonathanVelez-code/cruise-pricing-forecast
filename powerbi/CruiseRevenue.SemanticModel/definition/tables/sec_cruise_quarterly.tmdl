table sec_cruise_quarterly
	lineageTag: daae755a-aab7-4ba8-b64f-8f891509367e

	measure 'Occupancy % (normal ops)' = CALCULATE(AVERAGE(sec_cruise_quarterly[occupancy_pct]), sec_cruise_quarterly[covid_period] = FALSE())
		formatString: 0.0
		lineageTag: cff9ee81-79dd-497f-9930-c1b75ad0ad80

	measure 'Revenue per Passenger Day' = CALCULATE(AVERAGE(sec_cruise_quarterly[revenue_per_pcd]), sec_cruise_quarterly[covid_period] = FALSE())
