table experiment_sailings
	lineageTag: 2aab1fc4-12b0-4739-b7e6-ce06e8d5d61a

	measure 'Avg RevPAC' = AVERAGE(experiment_sailings[revpac])
		formatString: \$#,0
		lineageTag: efdaedd3-7ec3-4d29-8c11-3425f0510059

	measure 'Avg RevPAC (CUPED)' = AVERAGE(experiment_sailings[revpac_cuped])
		formatString: \$#,0
		lineageTag: c71f544f-ca8b-4aa1-ae75-4da0bb86c2ed

	measure 'Test Sailings' = COUNTROWS(experiment_sailings)
		formatString: #,0
		lineageTag: 737898ec-c5b2-4856-9b79-21fe550dce50

	measure 'Avg Final Occupancy' = AVERAGE(experiment_sailings[final_occupancy])
		formatString: 0.0%
