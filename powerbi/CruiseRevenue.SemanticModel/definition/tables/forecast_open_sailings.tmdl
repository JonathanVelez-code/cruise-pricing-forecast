table forecast_open_sailings
	lineageTag: eaeca31d-9513-4b8c-87d8-3a71dc11bfde

	measure 'Open Sailing-Categories' = COUNTROWS(forecast_open_sailings)
		formatString: #,0
		lineageTag: 83772c9f-39f9-4aa0-a33a-c3a353deb61c

	measure 'Booked Now' = DIVIDE(SUM(forecast_open_sailings[otb]), SUM(forecast_open_sailings[cabins_available]))
		formatString: 0.0%
		lineageTag: fe796a10-b1b7-4b63-9df1-ac68c25c439b

	measure 'Forecast Occupancy' = DIVIDE(SUM(forecast_open_sailings[forecast_final]), SUM(forecast_open_sailings[cabins_available]))
		formatString: 0.0%
		lineageTag: 94f12e70-55af-45e4-a580-5110a97fcdab

	measure 'Raise Price Count' = CALCULATE(COUNTROWS(forecast_open_sailings), forecast_open_sailings[recommendation] = "Raise price")
		formatString: #,0
		lineageTag: ee378da5-f845-413b-8a67-11d8b87d41ef

