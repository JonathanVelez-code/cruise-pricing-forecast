table fact_bookings
	lineageTag: a9c2e98a-c256-4b7c-abe2-25a94b9ed887

	measure 'Total Revenue' = CALCULATE(SUM(fact_bookings[price_paid]), fact_bookings[status] = "confirmed", dim_sailing[departed] = TRUE())
		formatString: \$#,0
		lineageTag: a05b3c65-ec70-4edd-b400-e5d130913c96

	measure 'Cabins Booked' = CALCULATE(COUNTROWS(fact_bookings), fact_bookings[status] = "confirmed", dim_sailing[departed] = TRUE())
		formatString: #,0
		lineageTag: d0ed085d-8bcb-45d5-b2d8-a4f6a245383a

	measure 'Cabins Available' = CALCULATE(SUM(fact_cabin_inventory[cabins_available]), dim_sailing[departed] = TRUE())
		formatString: #,0
		lineageTag: 6b1715ef-9a86-4d4b-8105-9916ae4b25c6

	measure 'Occupancy %' = DIVIDE([Cabins Booked], [Cabins Available])
		formatString: 0.0%
		lineageTag: c29a319e-3d63-4f6c-860b-c37b8b95527c

	measure 'Guest Nights' = CALCULATE(SUMX(fact_bookings, fact_bookings[guests] * RELATED(dim_sailing[nights])), fact_bookings[status] = "confirmed", dim_sailing[departed] = TRUE())
		formatString: #,0
		lineageTag: 78b9db4e-93ba-4069-9260-c96966d4bed6

	measure 'Capacity Nights' = CALCULATE(SUMX(fact_cabin_inventory, fact_cabin_inventory[cabins_available] * 2 * RELATED(dim_sailing[nights])), dim_sailing[departed] = TRUE())
		formatString: #,0
		lineageTag: 792573ea-b042-48cb-a764-1b89449be3d4

	measure 'Load Factor' = DIVIDE([Guest Nights], [Capacity Nights])
		formatString: 0.0%
		lineageTag: 46ecba86-261a-4d75-9de4-6b8c0c76c91d

	measure 'Cabin Nights Sold' = CALCULATE(SUMX(fact_bookings, RELATED(dim_sailing[nights])), fact_bookings[status] = "confirmed", dim_sailing[departed] = TRUE())
		formatString: #,0
		lineageTag: 82c1537a-7be2-4bd3-a4d1-a1c3d9e249c1

	measure 'Avg Price per Cabin-Night' = DIVIDE([Total Revenue], [Cabin Nights Sold])
		formatString: \$#,0
		lineageTag: 26afce94-23b2-47bd-a6ca-d1e12c6aea6a

	measure 'Revenue per Available Cabin' = DIVIDE([Total Revenue], [Cabins Available])
		formatString: \$#,0
		lineageTag: 8126d824-3fda-468a-83ed-11237191498a

	measure 'Cancellation Rate' = DIVIDE(CALCULATE(COUNTROWS(fact_bookings), fact_bookings[status] = "cancelled"), COUNTROWS(fact_bookings))
		formatString: 0.0%
		lineageTag: c6447876-01f1-41e2-961f-e1962767e6b7

