	partition fact_bookings = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\fact_bookings.csv"),[Delimiter=",", Columns=14, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"booking_id", Int64.Type}, {"guest_id", Int64.Type}, {"sailing_id", Int64.Type}, {"cabin_category", type text}, {"booking_date", type date}, {"days_out", Int64.Type}, {"guests", Int64.Type}, {"price_paid", type number}, {"price_imputed", type logical}, {"promo_code", type text}, {"channel", type text}, {"source_market", type text}, {"status", type text}, {"cancel_date", type date}}, "en-US")
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table

