table real_forecast_backtest
	lineageTag: b640cefb-0e0b-43f9-9f59-54c3eb6dd7d1

	measure 'RCL Actual (SEC)' = CALCULATE(AVERAGE(real_forecast_backtest[actual]), real_forecast_backtest[company] = "Royal Caribbean")
		formatString: \$#,0
		lineageTag: 8a816ac8-bc4c-4d2c-8957-7b13a0e99118

	measure 'RCL Model Forecast' = CALCULATE(AVERAGE(real_forecast_backtest[model]), real_forecast_backtest[company] = "Royal Caribbean")
		formatString: \$#,0
		lineageTag: ba8282c3-0ac5-4b73-a773-8f81bf628d50

	measure 'RCL Trend Baseline' = CALCULATE(AVERAGE(real_forecast_backtest[naive_plus_trend]), real_forecast_backtest[company] = "Royal Caribbean")
		formatString: \$#,0
		lineageTag: 1717632b-e395-42c9-b672-6f27a16fc64c

	measure 'RCL Same Quarter Last Year' = CALCULATE(AVERAGE(real_forecast_backtest[seasonal_naive]), real_forecast_backtest[company] = "Royal Caribbean")
		formatString: \$#,0
		lineageTag: 84245d20-65b0-49b2-9c3b-0ec290a6c2df

	measure 'Model Error %' = AVERAGEX(real_forecast_backtest, ABS(real_forecast_backtest[model] - real_forecast_backtest[actual]) / real_forecast_backtest[actual])
		formatString: 0.00%
		lineageTag: b6823beb-e5f0-4dff-9bde-152d40c9463d

	measure 'Trend Baseline Error %' = AVERAGEX(real_forecast_backtest, ABS(real_forecast_backtest[naive_plus_trend] - real_forecast_backtest[actual]) / real_forecast_backtest[actual])
		formatString: 0.00%
		lineageTag: 1efc31f5-c1b5-4f18-a981-07d0564d039f

	measure 'Last-Year Baseline Error %' = AVERAGEX(real_forecast_backtest, ABS(real_forecast_backtest[seasonal_naive] - real_forecast_backtest[actual]) / real_forecast_backtest[actual])
		formatString: 0.00%
		lineageTag: 43d4d269-07a6-44f5-be3f-e4048f51352e

