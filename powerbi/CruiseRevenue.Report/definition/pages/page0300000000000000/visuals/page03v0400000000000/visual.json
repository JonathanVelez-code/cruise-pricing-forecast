                  {
                    "value": "How the backtest works",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Trained on older sailings, tested on the most recent 6 months, never a random split.",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• A 180-day gap between training and test data, so the model never sees outcomes it couldn't have known.",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Baseline = last year's pace: what's booked now × (last year's final ÷ last year's booked at the same point).",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• The model's edge grows with the horizon: 4.0% vs. 17.6% error at 180 days out.",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ]
              }
            ]
